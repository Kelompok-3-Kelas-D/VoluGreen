# Local defaults. For production, set PRODUCTION=True and provide a strong secret.
PRODUCTION=False
DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL credentials used when PRODUCTION=True
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
SCHEMA=public

# Optional: use the default 301 redirect and one year HSTS in production.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
